# Copy this file to .env and fill in your own IBM watsonx.ai credentials.
# NEVER commit the real .env file (it is listed in .gitignore).

# Regional watsonx.ai endpoint (us-south shown here)
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Project ID of your watsonx.ai project (Project > Manage > General)
WATSONX_PROJECT_ID=your-project-id

# IBM Cloud API key (IBM Cloud > Manage > Access (IAM) > API keys)
WATSONX_APIKEY=your-ibm-cloud-api-key
